        <rules>
            <name>Capacity_Available</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Selected_Event.Tickets_Sold__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>Get_Selected_Event.Capacity__c</elementReference>
                </rightValue>
