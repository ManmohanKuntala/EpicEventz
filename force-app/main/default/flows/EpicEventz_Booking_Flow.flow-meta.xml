    <formulas>
        <name>Contact_First_Name</name>
        <dataType>String</dataType>
        <expression>
IF(
  CONTAINS(TRIM({!Customer_Full_Name}), &quot; &quot;),
  LEFT(
    TRIM({!Customer_Full_Name}),
    FIND(&quot; &quot;, TRIM({!Customer_Full_Name})) - 1
  ),
  &quot;&quot;
)</expression>
    </formulas>
    <formulas>
        <name>Contact_Last_Name</name>
        <dataType>String</dataType>
        <expression>
IF(
  CONTAINS(TRIM({!Customer_Full_Name}), &quot; &quot;),
  MID(
    TRIM({!Customer_Full_Name}),
    FIND(&quot; &quot;, TRIM({!Customer_Full_Name})) + 1,
    LEN(TRIM({!Customer_Full_Name}))
  ),
  TRIM({!Customer_Full_Name})
)</expression>
    </formulas>
    <formulas>
        <name>QR_Image_URL</name>
        <dataType>String</dataType>
        <expression>&quot;https://quickchart.io/qr?text=&quot; &amp;
{!Get_Created_Record.Ticket_Code__c} &amp;
&quot;&amp;size=200&quot;</expression>
    </formulas>
